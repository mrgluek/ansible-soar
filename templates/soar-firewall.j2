#!/bin/sh
# {{ ansible_managed }}
#
# Firewall for the soar DNS tunnel:
#   - public UDP 53 on {{ soar_iface }} is redirected to soar on {{ soar_port }};
#   - everything the soar user sends goes through chain SOAR_OUT, which only
#     lets it reach chatmail relays (ipset soar_relays) on mail ports and the
#     local resolver; anything else is refused and recorded in soar_rejected;
#   - /etc/soar/extra.txt adds fixed networks on given ports (e.g. a messenger's
#     data centres), IPv4 and IPv6; over IPv6 soar may reach nothing else.
#
#   soar-firewall [start]   (re)apply, safe to run any number of times
#   soar-firewall stop      remove the rules (ipsets are kept)
#
# Standalone on purpose: no iptables-persistent/netfilter-persistent, which
# apt removes as soon as anything installs ufw (that is how the tunnel lost
# its rules after a reboot on 2026-10-19). Rules are added next to whatever
# else is there (ufw, docker, fail2ban), never with iptables-restore, which
# would wipe their chains. Every rule carries the comment "soar" so it can be
# found and removed again, even after the interface or port changed.
set -eu

IFACE={{ soar_iface }}
PORT={{ soar_port }}
MAIL_PORTS={{ soar_allow_ports }}
SAVED=/etc/soar/relays.ipset
EXTRA=/etc/soar/extra.txt

# Delete every rule tagged "soar" from one chain. iptables -S prints rules as
# "-A CHAIN args"; turning -A into -D gives the matching delete command.
unsoar() {
    cmd=$1 table=$2 chain=$3
    $cmd -t "$table" -S "$chain" 2>/dev/null | grep -- '--comment soar' | sed 's/^-A /-D /' |
        while read -r rule; do eval "$cmd -t $table $rule"; done
}

stop() {
    unsoar iptables nat PREROUTING
    unsoar iptables filter INPUT
    unsoar iptables filter OUTPUT
    if iptables -n -L SOAR_OUT >/dev/null 2>&1; then
        iptables -F SOAR_OUT
        iptables -X SOAR_OUT
    fi
    if [ -e /proc/net/if_inet6 ]; then
        unsoar ip6tables filter OUTPUT
        if ip6tables -n -L SOAR_OUT >/dev/null 2>&1; then
            ip6tables -F SOAR_OUT
            ip6tables -X SOAR_OUT
        fi
    fi
}

# Fill soar_extra / soar_extra6 from $EXTRA: "<network> <port>[,<port>...]"
# per line, TCP, "#" starts a comment. The sets are rebuilt on every start,
# so removing a line removes the access. A bad line is reported and skipped
# rather than failing the whole firewall (soar.service Requires= it).
load_extra() {
    ipset create -exist soar_extra hash:net,port family inet
    ipset create -exist soar_extra6 hash:net,port family inet6
    ipset flush soar_extra
    ipset flush soar_extra6
    [ -e "$EXTRA" ] || return 0
    sed 's/#.*//' "$EXTRA" | while read -r net ports _; do
        [ -n "$net" ] || continue
        case $net in *:*) set=soar_extra6 ;; *) set=soar_extra ;; esac
        for port in $(echo "${ports:-}" | tr ',' ' '); do
            ipset add -exist "$set" "$net,tcp:$port" ||
                echo "soar-firewall: skipped bad line in $EXTRA: $net $ports" >&2
        done
        [ -n "${ports:-}" ] || echo "soar-firewall: no port for $net in $EXTRA, skipped" >&2
    done
}

start() {
    # ipsets first: the rules below refer to them by name. The relay list is
    # restored from the last refresh, so soar can reach relays right after a
    # reboot, before soar-relays.timer gets DNS to resolve them again.
    if [ -s "$SAVED" ]; then
        ipset restore -exist < "$SAVED"
    fi
    ipset create -exist soar_relays hash:ip timeout 86400
    # Refused destinations with counters; soar-stats reads and flushes it.
    ipset create -exist soar_rejected hash:ip,port timeout 3600 counters
    load_extra

    stop

    iptables -N SOAR_OUT
    iptables -A SOAR_OUT -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
    iptables -A SOAR_OUT -p tcp -m set --match-set soar_relays dst \
        -m multiport --dports "$MAIL_PORTS" -j ACCEPT
    # The port is part of each set entry (dst,dst = address and port).
    iptables -A SOAR_OUT -m set --match-set soar_extra dst,dst -j ACCEPT
    # soar resolves relay names through the system resolver, whatever it is
    # (systemd-resolved on 127.0.0.53, a chatmail relay's Unbound on
    # 127.0.0.1, ...). Taken from resolv.conf on every start; a path unit
    # re-runs this when resolv.conf changes (on 2026-10-27 a relay install
    # switched it to Unbound and soar could no longer resolve anything).
    # IPv4 only: soar gets no IPv6.
    # Early in boot resolv.conf can still be a dangling symlink into /run;
    # fall back to the systemd-resolved stub then.
    nameservers=$(awk '$1 == "nameserver" && $2 !~ /:/ {print $2}' /etc/resolv.conf 2>/dev/null || true)
    for ns in ${nameservers:-127.0.0.53}; do
        iptables -A SOAR_OUT -d "$ns" -p udp --dport 53 -j ACCEPT
        iptables -A SOAR_OUT -d "$ns" -p tcp --dport 53 -j ACCEPT
    done
    iptables -A SOAR_OUT -j SET --add-set soar_rejected dst,dst --exist
    iptables -A SOAR_OUT -j REJECT

    iptables -I OUTPUT -m owner --uid-owner soar -m comment --comment soar -j SOAR_OUT
    # Redirected packets arrive on $PORT; accept them even if ufw is enabled.
    iptables -I INPUT -i "$IFACE" -p udp --dport "$PORT" -m comment --comment soar -j ACCEPT
    iptables -t nat -I PREROUTING -i "$IFACE" -p udp --dport 53 -m comment --comment soar \
        -j REDIRECT --to-ports "$PORT"

    # IPv6: only the extra networks; relays and DNS stay IPv4-only.
    if [ -e /proc/net/if_inet6 ]; then
        ip6tables -N SOAR_OUT
        ip6tables -A SOAR_OUT -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
        ip6tables -A SOAR_OUT -m set --match-set soar_extra6 dst,dst -j ACCEPT
        ip6tables -A SOAR_OUT -j REJECT
        ip6tables -I OUTPUT -m owner --uid-owner soar -m comment --comment soar -j SOAR_OUT
    fi
}

case "${1:-start}" in
    start) start ;;
    stop) stop ;;
    *) echo "usage: $0 [start|stop]" >&2; exit 2 ;;
esac
